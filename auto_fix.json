{
  "name": "autofix",
  "title": "AutoFix",
  "desc": "Automated remediation preset for already-tagged PDFs. It applies machine-driven fixes from the PDFix action catalog—fonts and Unicode mapping, document language and title, PDF/UA metadata, structure and role mapping, artifacts, annotations, alternate descriptions, tag cleanup, heading and whitespace repair, and parent/ID trees—so you can batch-correct accessibility findings without manual editing in each file.",
  "keywords": [
    "autofix",
    "auto fix",
    "automated remediation",
    "batch accessibility",
    "accessibility",
    "pdf accessibility",
    "pdf/ua",
    "tagged pdf",
    "structure tree",
    "role map",
    "role mapping",
    "parent tree",
    "id tree",
    "embed fonts",
    "unicode mapping",
    "alternate text",
    "alt text",
    "artifact",
    "annotations",
    "tab order",
    "tabs key",
    "document language",
    "document title",
    "viewer preferences",
    "markinfo",
    "suspects",
    "optional content",
    "bookmarks",
    "headings",
    "tag id",
    "spaces in structure"
  ],
  "version": "0.1.0",
  "min_sdk_version": "8.8.0",
  "max_sdk_version": "",
  "release_date": "2026-05-13",
  "category": "Accessibility",
  "icon": "autofix",
  "settings": {
    "stop_on_action_failure": false
  },
  "actions": [
    {
      "desc": "Embed and fix all fonts used in the document to ensure consistent rendering and reliable text extraction across platforms and assistive technologies.",
      "name": "embed_font",
      "params": [
        {
          "ext": "",
          "flags": 0,
          "name": "embed_font",
          "type": "bool",
          "value": "false"
        },
        {
          "ext": "",
          "flags": 0,
          "name": "add_missing_unicode",
          "type": "bool",
          "value": "true"
        },
        {
          "ext": "",
          "flags": 0,
          "name": "type0_cid_system_info",
          "type": "bool",
          "value": "true"
        },
        {
          "ext": "",
          "flags": 0,
          "name": "type2_cid_to_gid_map",
          "type": "bool",
          "value": "true"
        },
        {
          "ext": "",
          "flags": 0,
          "name": "glyph_widths",
          "type": "bool",
          "value": "true"
        },
        {
          "ext": "",
          "flags": 0,
          "name": "notdef_glyph",
          "type": "bool",
          "value": "true"
        }
      ],
      "title": "Fix Fonts"
    },
    {
      "desc": "Set the document language",
      "name": "set_language",
      "params": [
        {
          "ext": "",
          "flags": 0,
          "name": "lang",
          "type": "lang",
          "value": "en-US"
        },
        {
          "ext": "",
          "flags": 0,
          "name": "overwrite",
          "type": "bool",
          "value": "false"
        }
      ],
      "title": "Set Document Language"
    },
    {
      "desc": "Set the document title",
      "name": "set_title",
      "params": [
        {
          "ext": "",
          "flags": 1,
          "name": "title_type",
          "type": "int",
          "value": "2"
        },
        {
          "ext": "",
          "flags": 0,
          "name": "custom_text",
          "type": "string",
          "value": ""
        },
        {
          "ext": "",
          "flags": 0,
          "name": "description_tag",
          "type": "string",
          "value": "Caption"
        },
        {
          "ext": "",
          "flags": 0,
          "name": "overwrite",
          "type": "bool",
          "value": "false"
        }
      ],
      "title": "Set Title"
    },
    {
      "desc": "Synchronize the ViewerPreferences DisplayDocTitle setting with the actual document title so that assistive technologies announce the correct title.",
      "name": "set_display_doc_title",
      "title": "Fix Display Document Title"
    },
    {
      "desc": "Set the PDF/UA identifier",
      "name": "set_pdf_ua_standard",
      "params": [
        {
          "ext": "",
          "flags": 1,
          "name": "part_number",
          "type": "string",
          "value": "1"
        },
        {
          "ext": "",
          "flags": 0,
          "name": "rev_number",
          "type": "string",
          "value": "2023"
        }
      ],
      "title": "Set PDF/UA Standard"
    },
    {
      "desc": "Fix the MarkInfo dictionary by clearing the Suspects entry, indicating that the document structure is no longer considered unreliable.",
      "name": "set_suspect_value",
      "title": "Set Suspect Value"
    },
    {
      "desc": "Repair Optional Content (OCG) configuration dictionaries to ensure layer definitions are valid and accessible.",
      "name": "fix_oc_name",
      "title": "Fix Optional Content"
    },
    {
      "desc": "Resolve issues in the document's Role Map to ensure correct structure type mappings",
      "name": "remove_standard_tags_mapping",
      "params": [
        {
          "ext": "",
          "flags": 0,
          "name": "standard_role_mapping",
          "type": "bool",
          "value": "true"
        },
        {
          "ext": "",
          "flags": 0,
          "name": "circular_role_mapping",
          "type": "bool",
          "value": "true"
        },
        {
          "ext": "",
          "flags": 0,
          "name": "clear_rolemap",
          "type": "bool",
          "value": "true"
        }
      ],
      "title": "Fix Role Mapping"
    },
    {
      "desc": "Mark defined content as an artifact",
      "name": "artifact_content",
      "params": [
        {
          "ext": "",
          "flags": 0,
          "name": "object_types",
          "type": "object",
          "value": {
            "template": {
              "object_update": [
                {
                  "query": {
                    "$and": [
                      {
                        "$0_artifact": "false"
                      },
                      {
                        "$0_mcid": "-1"
                      }
                    ],
                    "param": [
                      "pds_object"
                    ]
                  },
                  "statement": "$if"
                }
              ]
            }
          }
        },
        {
          "ext": "",
          "flags": 1,
          "name": "artifact_type",
          "type": "int",
          "value": "0"
        }
      ],
      "title": "Artifact Content"
    },
    {
      "desc": "Fix media clip content type keys to a safe default (text/plain) to prevent validation failures on embedded media metadata.",
      "name": "fix_media_clip_keys",
      "params": [
        {
          "ext": "",
          "flags": 1,
          "name": "ct_key",
          "type": "string",
          "value": "text/plain"
        }
      ],
      "title": "Fix Media Clip"
    },
    {
      "desc": "Set the page Tabs key to Structure so keyboard navigation follows the logical reading order.",
      "name": "set_tabs_key",
      "params": [
        {
          "ext": "",
          "flags": 0,
          "name": "tabs_key",
          "type": "string",
          "value": "S"
        },
        {
          "ext": "",
          "flags": 0,
          "name": "overwrite",
          "type": "bool",
          "value": "true"
        }
      ],
      "title": "Set Tab Order"
    },
    {
      "desc": "Set an alternative description for an annotation using the Contents key or TU key for widget annotations",
      "name": "set_annot_contents",
      "params": [
        {
          "ext": "",
          "flags": 0,
          "name": "annot_types",
          "type": "annot",
          "value": ".*"
        },
        {
          "ext": "",
          "flags": 1,
          "name": "alt_type",
          "type": "int",
          "value": "1"
        },
        {
          "ext": "",
          "flags": 0,
          "name": "custom_text",
          "type": "string",
          "value": "Decorative"
        },
        {
          "ext": "",
          "flags": 0,
          "name": "description_tag",
          "type": "string",
          "value": ""
        },
        {
          "ext": "",
          "flags": 0,
          "name": "bbox_padding_x",
          "type": "float",
          "value": "4"
        },
        {
          "ext": "",
          "flags": 0,
          "name": "bbox_padding_x_right",
          "type": "float",
          "value": "4"
        },
        {
          "ext": "",
          "flags": 0,
          "name": "bbox_padding_y_top",
          "type": "float",
          "value": "4"
        },
        {
          "ext": "",
          "flags": 0,
          "name": "bbox_padding_y",
          "type": "float",
          "value": "4"
        },
        {
          "ext": "",
          "flags": 0,
          "name": "overwrite",
          "type": "bool",
          "value": "false"
        }
      ],
      "title": "Set Annotation Contents"
    },
    {
      "desc": "Remove non-permitted annotation types that commonly cause PDF/UA compliance failures. TrapNet and PrinterMark annotations are production artifacts and must not be present in accessible documents.",
      "name": "delete_annot",
      "params": [
        {
          "ext": "",
          "flags": 0,
          "name": "annot_types",
          "type": "annot",
          "value": "^TrapNet$"
        }
      ],
      "title": "Delete Annotations"
    },
    {
      "desc": "Set an alternative description for the tag. These text alternatives are crucial for accessibility, helping users with vision impairments understand the content",
      "name": "set_alt",
      "params": [
        {
          "ext": "",
          "flags": 0,
          "name": "tag_names",
          "type": "tag",
          "value": "^Figure$|^Formula$"
        },
        {
          "ext": "",
          "flags": 1,
          "name": "alt_type",
          "type": "int",
          "value": "4"
        },
        {
          "ext": "",
          "flags": 0,
          "name": "custom_text",
          "type": "string",
          "value": "Decorative"
        },
        {
          "ext": "",
          "flags": 0,
          "name": "description_tag",
          "type": "string",
          "value": "Caption"
        },
        {
          "ext": "",
          "flags": 0,
          "name": "overwrite",
          "type": "bool",
          "value": "false"
        }
      ],
      "title": "Set Alternate Description"
    },
    {
      "desc": "Delete defined tags",
      "name": "delete_tags",
      "params": [
        {
          "ext": "",
          "flags": 0,
          "name": "tag_names",
          "type": "tag",
          "value": ".*"
        },
        {
          "ext": "",
          "flags": 1,
          "name": "tag_content",
          "type": "string",
          "value": "none"
        }
      ],
      "title": "Delete Tags"
    },
    {
      "desc": "Generate unique ID keys for Note and table header (TH) structure elements as required by PDF/UA.",
      "name": "set_tag_id",
      "params": [
        {
          "ext": "",
          "flags": 0,
          "name": "tag_names",
          "type": "tag",
          "value": "^Note$|^TH$"
        },
        {
          "ext": "",
          "flags": 0,
          "name": "overwrite",
          "type": "bool",
          "value": "false"
        }
      ],
      "title": "Set Tag ID"
    },
    {
      "desc": "Correct invalid or inappropriate placement attributes for tags such as Figure, Formula, Form, and Note.",
      "name": "fix_placement",
      "params": [
        {
          "ext": "",
          "flags": 0,
          "name": "tag_names",
          "type": "tag",
          "value": "^Figure$|^Formula$|^Form$|^Note$"
        }
      ],
      "title": "Fix Placement"
    },
    {
      "desc": "Add missing or resolve duplicate white spaces within a structure element",
      "name": "fix_structure_spaces",
      "params": [
        {
          "ext": "",
          "flags": 0,
          "name": "add_missing_spaces",
          "type": "bool",
          "value": "true"
        },
        {
          "ext": "",
          "flags": 0,
          "name": "remove_unnecessary_spaces",
          "type": "bool",
          "value": "false"
        },
        {
          "ext": "",
          "flags": 0,
          "name": "artifact_unnecessary_spaces",
          "type": "bool",
          "value": "true"
        }
      ],
      "title": "Fix Spaces"
    },
    {
      "desc": "Repair logical heading structure for accessibility (PDF/UA): optional H1–H6 from style, then fix invalid level sequence (no skipped levels).",
      "name": "fix_headings",
      "params": [
        {
          "ext": "",
          "flags": 0,
          "name": "fix_heading_levels",
          "type": "bool",
          "value": "true"
        },
        {
          "ext": "",
          "flags": 1,
          "name": "renumber_headings",
          "type": "int",
          "value": "2"
        },
        {
          "ext": "",
          "flags": 0,
          "name": "change_headings_to",
          "type": "",
          "value": "H"
        }
      ],
      "title": "Fix Headings"
    },
    {
      "desc": "Repair the structural parent tree to restore correct associations between page content and structure elements.",
      "name": "fix_parent_tree",
      "title": "Fix Parent Tree"
    },
    {
      "desc": "Repair the document ID tree to restore valid references for structure elements and tagged content.",
      "name": "fix_id_tree",
      "title": "Fix ID Tree"
    },
    {
      "desc": "Create bookmarks from the tag tree hierarchy",
      "name": "create_bookmarks",
      "params": [
        {
          "ext": "",
          "flags": 0,
          "name": "tag_1",
          "type": "tag",
          "value": "^H1$"
        },
        {
          "ext": "",
          "flags": 0,
          "name": "tag_2",
          "type": "tag",
          "value": "^H2$"
        },
        {
          "ext": "",
          "flags": 0,
          "name": "tag_3",
          "type": "tag",
          "value": "^H3$"
        },
        {
          "ext": "",
          "flags": 0,
          "name": "tag_4",
          "type": "tag",
          "value": "^H4$"
        },
        {
          "ext": "",
          "flags": 0,
          "name": "tag_5",
          "type": "tag",
          "value": "^H5$"
        },
        {
          "ext": "",
          "flags": 0,
          "name": "tag_6",
          "type": "tag",
          "value": "^H6$"
        },
        {
          "ext": "",
          "flags": 0,
          "name": "overwrite",
          "type": "bool",
          "value": "false"
        }
      ],
      "title": "Create Bookmarks"
    }
  ]
}
